{
	"useTabs": true,
	"printWidth": 9999,
	"tabWidth": 2,
	"singleQuote": false,
	"trailingComma": "es5",
	"plugins": ["prettier-plugin-nunjucks"],
	"overrides": [
		{
			"files": "*.njk",
			"options": {
				"parser": "nunjucks"
			}
		},
		{
			"files": "*.html",
			"options": {
				"parser": "nunjucks"
			}
		}
	]
}
