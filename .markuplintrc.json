{
	"extends": ["markuplint:recommended"],
	"parser": {
		".njk$": "@markuplint/nunjucks-parser",
		".html$": "@markuplint/nunjucks-parser"
	},
	"excludeFiles": ["_site/**"],
	"rules": {
		"ineffective-attr": false
	},
	"nodeRules": [
		{
			"selector": "script[src$=\"verhuismelding.js\"]",
			"rules": {
				"required-attr": false
			}
		}
	]
}
