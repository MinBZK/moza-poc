{# Voorkomt dat de berichten even te zien zijn voordat de voortgangsbalk verschijnt.

   berichtenbox.js is een module en draait dus ná alle klassieke defer-scripts, terwijl de browser
   de server-gerenderde rijen al tijdens het parsen op het scherm zet. Geen enkel script kan dat
   inhalen. Dit scriptje staat vóór de lijst in het document en blokkeert het parsen op die plek,
   dus het draait voordat er iets van de tabel te zien is.

   Het beslist niets over de animatie zelf; het zet alleen dezelfde vlag die berichtenbox.js daarna
   overneemt. Neemt die het niet over — een fout in de module, of JavaScript dat er niet doorkomt —
   dan geeft `load` de lijst alsnog vrij. #}
<script>
	(function () {
		var wortel = document.documentElement;

		function vrijgeven() {
			delete wortel.dataset.berichtenboxVoortgang;
		}

		// Alleen op de eerste pagina; verderop in de lijst hoort geen ophaalanimatie.
		if ((new URLSearchParams(location.search).get("pagina") || "1") !== "1") return;

		// Dezelfde afweging als in berichtenbox.js: is dit het eerste bezoek? Is de opslag niet te
		// lezen, dan komt die module ook op een verse staat uit, en dus op ja.
		try {
			var bewaard = JSON.parse(localStorage.getItem("berichtenbox") || "{}");
			if (bewaard && bewaard.eersteBezoekGehad) return;
		} catch (fout) {
			// Bewust doorgaan: de module doet dat ook, en uiteenlopen geeft juist een flits.
		}

		wortel.dataset.berichtenboxVoortgang = "wacht";

		window.__berichtenboxVoortgang = { overgenomen: false, vrijgeven: vrijgeven };

		// Vangnet. Modulescripts draaien vóór `load`, dus is de vlag hier nog van ons, dan is de
		// module niet aan bod gekomen en hoort de lijst gewoon zichtbaar te zijn.
		window.addEventListener("load", function () {
			if (!window.__berichtenboxVoortgang.overgenomen) vrijgeven();
		});
	})();
</script>
