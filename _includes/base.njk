<!DOCTYPE html>
<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script>
			// Self-healing opruimen van een verouderde service worker + caches die
			// soms de oude (Belastingdienst-snapshot) pagina serveerden. Dit
			// prototype gebruikt zelf geen service worker, dus alles veilig weg.
			// Geen handmatig cache legen meer nodig.
			if ("serviceWorker" in navigator) {
				navigator.serviceWorker.getRegistrations().then(function (regs) {
					regs.forEach(function (r) {
						r.unregister();
					});
				});
			}
			if (window.caches && caches.keys) {
				caches.keys().then(function (keys) {
					keys.forEach(function (k) {
						caches.delete(k);
					});
				});
			}
		</script>
		<title>{{ title }}</title>
		<link rel="stylesheet" href="{{ '/style/style.css' | url }}" />
		<meta name="description" content="{{ description | default('MijnOverheid Zakelijk') }}" />
		{% set faviconPad = "/mijn-belastingdienst/assets" if headerType == "belastingdienst" else "/assets/favicon" %}
		<link rel="shortcut icon" href="{{ (faviconPad + '/favicon.ico') | url }}" type="image/x-icon" />
		<link rel="icon" sizes="192x192" href="{{ (faviconPad + '/touch-icon.png') | url }}" />
		<link rel="apple-touch-icon" href="{{ (faviconPad + '/apple-touch-icon.png') | url }}" />
		{% if styles %}
			{% for s in styles %}
				<link rel="stylesheet" href="{{ s }}" />
			{% endfor %}
		{% endif %}
		{% if extraStyles %}
			{{ extraStyles | safe }}
		{% endif %}
	</head>
	<body
		{% if bodyClass %}
			class="{{ bodyClass }}"
		{% endif %}
	>

		{% if headerType == "overheid" %}
			{% include "header-overheid.njk" %}
		{% elif headerType == "overheid-uitgelogd" %}
			{% include "header-overheid-uitgelogd.njk" %}
		{% elif headerType == "mobu" %}
			{% include "header-mobu.njk" %}
		{% elif headerType == "mobu-uitgelogd" %}
			{% include "header-mobu-uitgelogd.njk" %}
		{% elif headerType == "belastingdienst" %}
			{% include "header-belastingdienst.njk" %}
		{% elif headerType != "none" %}
			{% include "header-rijksoverheid.njk" %}
		{% endif %}

		{# Feature flag beschikbaar op alle moza-pagina's; verborgen marker zodat het
		flags-paneel de optie toont, ook op pagina's zonder eigen unhappy-content. #}
		{% if page.url.startsWith('/moza/') %}
			<span hidden data-feature="Berichtenbox unhappy flow" data-feature-type="functionaliteit" data-feature-default="off"></span>
		{% endif %}

		<main>{{ content | safe }}</main>

		{% if footerType == "overheid" %}
			{% include "footer-overheid.njk" %}
		{% elif footerType == "mobu" %}
			{% include "footer-mobu.njk" %}
		{% elif footerType == "belastingdienst" %}
			{% include "footer-belastingdienst.njk" %}
		{% elif footerType != "none" %}
			<footer></footer>
		{% endif %}

		<script>
			window.PATH_PREFIX = "{{ '/' | url }}";
		</script>
		<script>
			window.MOZA_CHAT_API = {{ chatApi | dump | safe }};
		</script>
		<script src="{{ '/assets/javascript/side-nav-toggle.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/aria-disabled.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/indeterminate.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/account-switcher.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/content-interactions.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/feature-flags.js' | url }}" defer></script>
		<script>
			window.personasData = {{ personas | dump | safe }};
		</script>
		<script>
			window.subsidiesData = {{ subsidiesData | dump | safe }};
		</script>
		<script>
			window.regelgevingData = {{ regelgevingData | dump | safe }};
		</script>
		<script>
			window.activiteitenLogData = {{ activiteitenLogData | dump | safe }};
		</script>
		<script src="{{ '/assets/javascript/personas.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/assistent-vraag.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/homepage-profiel.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/external-links.js' | url }}" defer></script>
		<!-- Klassiek en vóór de module: de ophaalronde bij het stelsel start zo vroeg mogelijk, en
		     berichtenbox.js draait als module hoe dan ook ná alle defer-scripts. -->
		<script src="{{ '/assets/javascript/berichtenbox-keten.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/berichtenbox.js' | url }}" type="module"></script>
		<script src="{{ '/assets/javascript/lopende-zaken.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/digitale-assistent-demo.js' | url }}" defer></script>
		<script src="{{ '/assets/javascript/digitale-assistent.js' | url }}" defer></script>
		<!-- React Islands hydration -->
		<script src="{{ '/js/islands.js' | url }}" defer></script>
	</body>
</html>
