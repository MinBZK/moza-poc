		<title>{{ title }}</title>
		<link rel="shortcut icon" href="/mailbox/favicon/favicon.ico" type="image/x-icon" />
		<link rel="icon" sizes="192x192" href="/mailbox/favicon/touch-icon.png" />
		<link rel="apple-touch-icon" href="/mailbox/favicon/apple-touch-icon.png" />
		<link rel="stylesheet" href="/mailbox/styles.css" />
	</head>
	<body>
