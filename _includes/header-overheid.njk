<header>
	<a class="skip-link btn-cta" href="#hoofd-inhoud">Ga naar hoofdinhoud</a>

	<div class="logo">
		<figure>
			<a href="/">
				<img src="{{ '/assets/images/beeldmerk-rijksoverheid.svg' | url }}" alt="Naar de homepage van MijnOverheid Zakelijk">
			</a>
		</figure>
		<a href="#" class="language-switch">English</a>
	</div>

	<div class="page-head">
		<span class="page-title">MijnOverheid Zakelijk</span>
		<div class="user-menu">
			<div class="account-switcher" data-feature="Accountwisselaar" data-feature-type="functionaliteit">
				<button class="account-switcher-toggle icon-label {% if '/moza/belang-' in page.url %}group-label-authorized{% else %}group-label-business{% endif %}" aria-expanded="false" aria-haspopup="true">
					{% if '/moza/belang-' in page.url %}{% icon "/assets/icons/icon-belang.svg" %}{% else %}{% icon "/assets/icons/icon-werk.svg" %}{% endif %}
					<span class="account-switcher-label"{% if '/moza/belang-' not in page.url %} data-profiel="initialen-bedrijf"{% endif %}>{% if '/moza/belang-vve/' in page.url %}Robin Vogel voor VvE Residentie Parkzicht{% elif '/moza/belang-tuin/' in page.url %}Robin Vogel voor Volkstuinvereniging De Groene Long{% elif '/moza/belang-winter/' in page.url %}Robin Vogel voor Familiebedrijf Winter{% else %}Robin Vogel van Bloom B.V.{% endif %}</span>
				</button>
				{% include "account-switcher-menu.njk" %}
			</div>
			<span class="icon-label account-switcher-fallback">
				{% include "icon-persoon.njk" %}
				<span data-profiel="naam">Robin Vogel</span>
			</span>
			<a class="icon-link" href="{{ '/moza/uitgelogd/' | url }}">
				{% include "icon-inloggen.njk" %}
				Uitloggen
			</a>
		</div>
	</div>

	<!-- Proof of concept banner -->
	<a class="temp-moza-poc-banner" href="https://www.mijnoverheidzakelijk.nl/">Proof of Concept</a>

</header>
