# De upstream staat in een variabele en wordt via de resolver van de pod opgezocht op het moment
# van het verzoek. Zo start nginx ook als de kerncontainer er nog niet is, en volgt hij een nieuw
# adres zonder herstart. NGINX_LOCAL_RESOLVERS komt uit 15-local-resolvers.envsh van het image.
server {
	listen 8080;

	client_max_body_size 10m;
	resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

	location / {
		set $kern "${NLW_KERN}";
		proxy_pass http://$kern;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_read_timeout 300s;
	}
}
