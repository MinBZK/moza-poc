# 1) Bouw de statische Eleventy-site (inclusief Storybook)
FROM node:20-alpine AS site_builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN cd style-dictionary && npm ci && npm run build
RUN npx @11ty/eleventy && ls -d _site
RUN npx storybook build -o _site/storybook


# 2) Serveer de site via nginx (non-root, poort 8080)
#
# Dit prototype draaide op een Python-image met de host-service van de Digitale
# Assistent erin. Dat image is niet meer te bouwen: services/host pint
# geen versies, en met de bibliotheken van nu (mcp, anthropic, openai) loopt de
# host bij het opstarten stuk op het registreren van de MCP-servers — de pod
# start niet, en de release-URL blijft op een 503 staan.
#
# Een onderzoeksrelease bestaat om terug te kunnen zien wat er is voorgelegd, en
# dat zijn de pagina's. Die serveren we hier statisch, net als de releases van
# maart en daarna. De chat op /moza/digitale-assistent/ antwoordt daardoor niet.
FROM nginxinc/nginx-unprivileged:stable-alpine-slim

COPY --from=site_builder /app/_site /usr/share/nginx/html
COPY container/nginx.conf /etc/nginx/nginx.conf
COPY container/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
