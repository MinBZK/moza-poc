# 1) Bouw de statische Eleventy-site (inclusief Storybook)
FROM node:22-alpine AS site_builder

WORKDIR /app
COPY package.json package-lock.json ./
# Disable optional dependencies in CI build to avoid native-binding optional deps failures
ENV NPM_CONFIG_OMIT=optional
RUN npm ci --omit=optional
COPY . .

# Backend-URL voor de chat-frontend (instelbaar per omgeving):
#   leeg ("")  = relatief / zelfde origin (reverse proxy)  -- default
#   https://…  = expliciete backend-URL (cross-origin; vereist CORS in de backend)
ARG MOZA_CHAT_API=""
ENV MOZA_CHAT_API=$MOZA_CHAT_API
RUN npx @11ty/eleventy && ls -d _site
# RUN npx storybook build -o _site/storybook
 

# 2) Serveer de statische site via nginx + same-origin reverse proxy
#    (frontend-only, non-root, poort 8080)
FROM nginxinc/nginx-unprivileged:alpine

# /chat, /chat/stream, /health en /tools worden intern naar de backend geproxyd.
# BACKEND_ORIGIN is een RUNTIME env-var: zet 'm op het ZAD-component `proef` via de
# ZAD-UI (de zad-actions/deploy-action kan geen runtime-env zetten). Default = het
# interne cluster-adres van de backend.
#  - NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 laat 15-local-resolvers.envsh de DNS-resolver
#    uit /etc/resolv.conf afleiden (→ NGINX_LOCAL_RESOLVERS) voor runtime-resolutie.
#  - NGINX_ENVSUBST_FILTER beperkt envsubst tot alle BACKEND_*-vars en de resolver, zodat
#    nginx-eigen variabelen ($host, $uri, $backend_origin, ...) ongemoeid blijven — die zijn
#    kleine letters en vallen dus buiten het patroon. Het patroon is bewust generiek: staat een
#    backend-var er niet in, dan blijft zijn ${...} letterlijk in de config staan. Elke var
#    hieronder heeft een lege default. Nodig is dat niet — nginx leest een niet-gesubstitueerde
#    ${...} als een eigen, ongeïnitialiseerde variabele en dus als leeg, dus de terugval in de
#    template vuurt dan ook (gemeten). Het staat er zodat de bedoelde waarde "leeg" expliciet is
#    en niet per ongeluk uit dat gedrag volgt.
#
# BACKEND_ORIGIN is het adres van die chat-backend en verder niets. BACKEND_API is de
# standaard-upstream voor alles onder /api/. Leeg gelaten valt BACKEND_API terug op
# BACKEND_ORIGIN, dus alles onder /api/ gaat dan waar het vroeger ook heen ging. Wie hem wel zet,
# haalt de chat-backend uit het routeringspad van API's die er niets mee te maken hebben — nuttig
# in een omgeving waar die backend helemaal niet draait. Maak BACKEND_ORIGIN dan niet leeg: die is
# de bodem van elke terugval, en een lege bodem levert een 502 met uitleg (geen kale 500, zie
# container/geen-backend-origin.conf).
# De config wordt bij container-start gegenereerd uit /etc/nginx/templates/.
ENV BACKEND_ORIGIN=http://dabackend:8000 \
    BACKEND_API= \
    BACKEND_PROFIEL= \
    BACKEND_API_2= \
    BACKEND_KETEN= \
    BACKEND_DEMO= \
    BACKEND_KETEN_HOST= \
    BACKEND_DEMO_HOST= \
    NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 \
    NGINX_ENVSUBST_FILTER='^(BACKEND_[A-Z0-9_]+|NGINX_LOCAL_RESOLVERS)$'

COPY container/default.conf.template /etc/nginx/templates/default.conf.template

# Guards die vanuit meerdere locations ingesloten worden. Geen template: er staat geen ${...} in,
# dus envsubst hoeft er niet langs.
COPY container/geen-backend-origin.conf container/geen-backend-keten.conf /etc/nginx/
COPY --from=site_builder /app/_site /usr/share/nginx/html

EXPOSE 8080
