# 1) Bouw de statische Eleventy-site (inclusief Storybook)
FROM node:20-alpine AS site_builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN cd style-dictionary && npm ci && npm run build

# Backend-URL voor de chat-frontend (instelbaar per omgeving):
#   leeg ("")  = relatief / zelfde origin (reverse proxy)  -- default
#   https://…  = expliciete backend-URL (cross-origin; vereist CORS in de backend)
ARG MOZA_CHAT_API=""
ENV MOZA_CHAT_API=$MOZA_CHAT_API
RUN npx @11ty/eleventy && ls -d _site
RUN npx storybook build -o _site/storybook


# 2) Serveer de statische site via nginx + same-origin reverse proxy
#    (frontend-only, non-root, poort 8080)
FROM nginxinc/nginx-unprivileged:alpine

# /chat, /health en /tools worden naar de backend geproxyd. BACKEND_ORIGIN is
# runtime instelbaar (envsubst). Default 127.0.0.1:8000 zodat nginx altijd start;
# zonder backend faalt alleen de chat (502), de statische site blijft werken.
ENV BACKEND_ORIGIN=127.0.0.1:8000

COPY container/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=site_builder /app/_site /usr/share/nginx/html

EXPOSE 8080
