#!/bin/sh
# Adres van het component nlw-api (container/nl-wallet-api) als BACKEND_NL_WALLET leeg is. Op ZAD
# heet een Service <deployment>-<component>, en DEPLOYMENT_NAME staat in elke pod. Lokaal (zonder
# DEPLOYMENT_NAME) blijft de variabele leeg en antwoordt nginx op /api/nl-wallet/ met een 502 die
# dat zegt.
if [ -z "${BACKEND_NL_WALLET}" ] && [ -n "${DEPLOYMENT_NAME}" ]; then
	export BACKEND_NL_WALLET="http://${DEPLOYMENT_NAME}-nlw-api:8095"
fi
echo "nl-wallet: BACKEND_NL_WALLET=${BACKEND_NL_WALLET:-<leeg>}"
